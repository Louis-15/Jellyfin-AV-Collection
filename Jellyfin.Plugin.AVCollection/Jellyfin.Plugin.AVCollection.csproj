<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jellyfin.Plugin.AVCollection</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.AVCollection</AssemblyName>
    <Version>1.0.2.9</Version>
    <AssemblyVersion>1.0.2.9</AssemblyVersion>
    <FileVersion>1.0.2.9</FileVersion>
    <Company>Jellyfin-AV-Collection</Company>
    <Authors>Jellyfin-AV-Collection</Authors>
    <Description>Builds Jellyfin collections from AV actors, uses the actor portrait as the collection poster and merges several stage names of the same actor into one collection.</Description>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!--
      绝不把 Jellyfin / ASP.NET 的依赖程序集拷到插件目录。
      Jellyfin 会把插件目录里的每个 dll 都加载进独立的 PluginLoadContext，
      多一份框架程序集就等于给同一类型造了第二个身份，DI 会静默匹配失败。
    -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 前端资源打进 dll，和 Jellyfin 自带插件一致（部署时只有一个 dll + meta.json + logo）。 -->
    <EmbeddedResource Include="Web\**\*.html" />
    <EmbeddedResource Include="Web\**\*.js" />
  </ItemGroup>

  <ItemGroup>
    <!--
      设置页要调本程序集里的 API 控制器。Jellyfin 会把插件程序集加入 MVC 的
      ApplicationParts，但 MVC 类型只存在于 ASP.NET Core 共享框架里，必须对齐服务端。
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.AVCollection.Tests" />
  </ItemGroup>

</Project>
